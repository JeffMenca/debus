{
  "name": "debus",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "local": "node scripts/local.mjs",
    "local:setup": "node scripts/local.mjs --setup-only",
    "local:down": "docker compose down",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "node scripts/test-coverage.mjs unit",
    "test:integration": "node scripts/test-coverage.mjs integration",
    "test:e2e": "sh -c 'turbo run test:e2e \"$@\"; s=$?; node scripts/clean-test-data.mjs; exit $s' --",
    "test:e2e:real": "sh -c 'E2E_REAL_API=1 E2E_BASE_URL=${E2E_BASE_URL:-http://localhost:3000} E2E_ADMIN_EMAIL=${E2E_ADMIN_EMAIL:-admin@debus.local} pnpm --filter @debus/web exec playwright test --workers=1 \"$@\"; s=$?; node scripts/clean-test-data.mjs; exit $s' --",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:clean": "node scripts/clean-test-data.mjs",
    "check": "turbo run lint typecheck test",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .git/info/exclude --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .git/info/exclude --ignore-path .prettierignore",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "pubsub:provision": "turbo run build --filter=@debus/messaging && node scripts/provision-pubsub.mjs",
    "db:prune": "node scripts/prune-local-events.mjs",
    "new-service": "node scripts/new-service.mjs",
    "mirror": "node scripts/mirror-repos.mjs",
    "test:scripts": "node --test scripts/lib/mirror.test.mjs",
    "seed": "turbo run build --filter=@debus/tools && node packages/tools/dist/seed/cli.js",
    "docs": "turbo run build --filter=@debus/tools && node packages/tools/dist/docs/cli.js",
    "postman": "turbo run build --filter=@debus/tools && node packages/tools/dist/postman/cli.js",
    "postman:test": "sh -c 'pnpm --filter @debus/tools exec newman run ../../postman/debus.postman_collection.json -e ../../postman/local.postman_environment.json --env-var adminPassword=${SEED_ADMIN_PASSWORD:-clave-segura-1} --env-var branchPassword=${SEED_PASSWORD:-debus-demo-2026} --env-var clientPassword=${SEED_PASSWORD:-debus-demo-2026}; s=$?; node scripts/clean-test-data.mjs; exit $s'",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@debus/config": "workspace:*",
    "@debus/contracts": "workspace:*",
    "@debus/messaging": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
