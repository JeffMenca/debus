generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model ProcessedEvent {
  eventId     String   @id @map("event_id")
  type        String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@map("processed_events")
}

model OutboxEvent {
  eventId      String    @id @map("event_id")
  type         String
  envelope     Json
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(3)
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")
  claimedUntil DateTime? @map("claimed_until") @db.Timestamptz(3)

  @@map("outbox")
}

enum TicketStatus {
  PENDING
  CONFIRMED
}

enum SaleChannel {
  ONLINE
  COUNTER
}

// Copy of the regular trips scheduled in viajes (TripScheduled); its capacity is the seat map.
model Trip {
  tripId             String       @id @map("trip_id") @db.Uuid
  branchId           String       @map("branch_id") @db.Uuid
  routeId            String       @map("route_id") @db.Uuid
  busId              String       @map("bus_id") @db.Uuid
  busPlate           String       @map("bus_plate")
  originLabel        String       @map("origin_label")
  destinationLabel   String       @map("destination_label")
  capacity           Int
  ticketPrice        Decimal      @map("ticket_price") @db.Decimal(10, 2)
  departureAt        DateTime     @map("departure_at") @db.Timestamptz(3)
  estimatedArrivalAt DateTime     @map("estimated_arrival_at") @db.Timestamptz(3)
  searchText         String       @map("search_text")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  tickets            Ticket[]
  seats              TicketSeat[]

  @@index([departureAt, tripId])
  @@map("trips")
}

model Ticket {
  id        String       @id @db.Uuid
  tripId    String       @map("trip_id") @db.Uuid
  trip      Trip         @relation(fields: [tripId], references: [tripId], onDelete: Cascade)
  status    TicketStatus
  channel   SaleChannel
  clientId  String?      @map("client_id") @db.Uuid
  nit       String
  buyerName String       @map("buyer_name")
  email     String?
  unitPrice Decimal      @map("unit_price") @db.Decimal(10, 2)
  total     Decimal      @db.Decimal(12, 2)
  paidOn    DateTime     @map("paid_on") @db.Date
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  seats     TicketSeat[]

  @@index([clientId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([nit])
  @@map("tickets")
}

// Only taken seats have a row: the primary key is what keeps a seat from being sold twice.
model TicketSeat {
  tripId     String @map("trip_id") @db.Uuid
  trip       Trip   @relation(fields: [tripId], references: [tripId], onDelete: Cascade)
  seatNumber Int    @map("seat_number")
  ticketId   String @map("ticket_id") @db.Uuid
  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([tripId, seatNumber])
  @@index([ticketId])
  @@map("ticket_seats")
}

// Copy of the NIT of each client profile (ProfileUpdated). Not unique: a NIT can move from one
// client to another and their events may arrive out of order, so the newest copy wins.
model ClientNit {
  clientId  String   @id @map("client_id") @db.Uuid
  nit       String?
  fullName  String   @map("full_name")
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([nit])
  @@map("client_nits")
}

enum PurchaseStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum PurchaseFailure {
  INSUFFICIENT_BALANCE
  PAYMENT_EXPIRED
  WALLET_NOT_READY
  WALLET_UNAVAILABLE
  PAYMENT_REJECTED
  TRIP_CANCELLED
}

// The record of a purchase made with the wallet. Its id is the ticket id and the Idempotency-Key.
// It outlives the compensation (a failed purchase deletes its ticket, not this row), and it has no
// foreign key to the trip so it survives the removal of the trip copy.
model Purchase {
  id            String           @id @db.Uuid
  clientId      String           @map("client_id") @db.Uuid
  tripId        String           @map("trip_id") @db.Uuid
  seats         Int[]
  amount        Decimal          @db.Decimal(12, 2)
  description   String
  paidOn        DateTime         @map("paid_on") @db.Date
  payBy         DateTime         @map("pay_by") @db.Timestamptz(3)
  status        PurchaseStatus
  failure       PurchaseFailure?
  debitAttempts Int              @default(0) @map("debit_attempts")
  lastError     String?          @map("last_error")
  lockedUntil   DateTime?        @map("locked_until") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, updatedAt, id])
  @@index([clientId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("purchases")
}
