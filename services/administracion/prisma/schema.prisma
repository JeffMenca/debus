generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model ProcessedEvent {
  eventId     String   @id @map("event_id")
  type        String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@map("processed_events")
}

model OutboxEvent {
  eventId      String    @id @map("event_id")
  type         String
  envelope     Json
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(3)
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")
  claimedUntil DateTime? @map("claimed_until") @db.Timestamptz(3)

  @@map("outbox")
}

enum UserRole {
  SYSTEM_ADMIN
  BRANCH_ADMIN
  CASHIER
  DRIVER
  CLIENT
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum AccountLinkPurpose {
  ACTIVATION
  PASSWORD_RESET
}

model User {
  id               String         @id @default(uuid()) @db.Uuid
  email            String         @unique
  fullName         String         @map("full_name")
  role             UserRole
  branchId         String?        @map("branch_id") @db.Uuid
  status           UserStatus     @default(PENDING)
  passwordHash     String?        @map("password_hash")
  nit              String?        @unique
  pendingProfile   Json?          @map("pending_profile")
  searchText       String         @default("") @map("search_text")
  failedLoginCount Int            @default(0) @map("failed_login_count")
  lockedUntil      DateTime?      @map("locked_until") @db.Timestamptz(3)
  lastNoticeAt     DateTime?      @map("last_notice_at") @db.Timestamptz(3)
  createdById      String?        @map("created_by_id") @db.Uuid
  activatedAt      DateTime?      @map("activated_at") @db.Timestamptz(3)
  // Version of the last driver snapshot applied (drivers only): older snapshots never overwrite newer ones.
  driverVersion    Int?           @map("driver_version")
  // Raised on every change announced with UserUpdated, so the copies keep the newest one.
  version          Int            @default(1)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch           Branch?        @relation(fields: [branchId], references: [id])
  links            AccountLink[]
  refreshTokens    RefreshToken[]

  @@index([role, status])
  @@index([branchId])
  @@map("users")
}

model AccountLink {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  purpose   AccountLinkPurpose
  tokenHash String             @unique @map("token_hash")
  expiresAt DateTime           @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?          @map("used_at") @db.Timestamptz(3)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User               @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("account_links")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id])

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model Branch {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  name         String   @unique
  department   String
  municipality String
  address      String
  phone        String
  latitude     Decimal  @db.Decimal(9, 6)
  longitude    Decimal  @db.Decimal(9, 6)
  searchText   String   @default("") @map("search_text")
  active       Boolean  @default(true)
  version      Int      @default(1)
  createdById  String?  @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  users        User[]

  @@map("branches")
}

model SettingsVersion {
  id                String   @id @default(uuid()) @db.Uuid
  depreciationPerKm Decimal  @map("depreciation_per_km") @db.Decimal(10, 2)
  rentalRatePerKm   Decimal  @map("rental_rate_per_km") @db.Decimal(10, 2)
  effectiveFrom     DateTime @map("effective_from") @db.Date
  createdById       String   @map("created_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([effectiveFrom, createdAt])
  @@map("settings_versions")
}

// Minimal copy of the buses of flota (Bus* events), to check a repair expense belongs to the branch.
model BusCopy {
  id        String   @id @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  plate     String
  active    Boolean
  version   Int
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([branchId, active])
  @@map("bus_copies")
}

model ExpenseCategory {
  id         String              @id @default(uuid()) @db.Uuid
  name       String
  active     Boolean             @default(true)
  searchText String              @default("") @map("search_text")
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  lines      RepairExpenseLine[]

  @@map("expense_categories")
}

enum RepairLineKind {
  LABOR
  PART
}

model RepairExpense {
  id          String              @id @db.Uuid
  branchId    String              @map("branch_id") @db.Uuid
  busId       String              @map("bus_id") @db.Uuid
  busPlate    String              @map("bus_plate")
  serviceDate DateTime            @map("service_date") @db.Date
  total       Decimal             @db.Decimal(12, 2)
  laborTotal  Decimal             @map("labor_total") @db.Decimal(12, 2)
  partsTotal  Decimal             @map("parts_total") @db.Decimal(12, 2)
  createdById String              @map("created_by_id") @db.Uuid
  searchText  String              @default("") @map("search_text")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  lines       RepairExpenseLine[]

  @@index([branchId, serviceDate, id])
  @@index([busId])
  @@map("repair_expenses")
}

model RepairExpenseLine {
  id          String          @id @default(uuid()) @db.Uuid
  expenseId   String          @map("expense_id") @db.Uuid
  expense     RepairExpense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  categoryId  String          @map("category_id") @db.Uuid
  category    ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  kind        RepairLineKind
  description String
  amount      Decimal         @db.Decimal(12, 2)
  position    Int

  @@index([expenseId])
  @@index([categoryId])
  @@map("repair_expense_lines")
}

enum TripCostType {
  REGULAR
  RENTAL
}

// The fuel and depreciation of a completed trip (TripCompleted); the primary key makes it idempotent.
model TripCost {
  tripId             String       @id @map("trip_id") @db.Uuid
  branchId           String       @map("branch_id") @db.Uuid
  busId              String       @map("bus_id") @db.Uuid
  tripType           TripCostType @map("trip_type")
  arrivedAt          DateTime     @map("arrived_at") @db.Timestamptz(3)
  distanceKm         Int          @map("distance_km")
  fuelCost           Decimal      @map("fuel_cost") @db.Decimal(10, 2)
  depreciationPerKm  Decimal      @map("depreciation_per_km") @db.Decimal(10, 2)
  depreciationAmount Decimal      @map("depreciation_amount") @db.Decimal(12, 2)
  driverPay          Decimal      @map("driver_pay") @db.Decimal(10, 2)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([branchId, arrivedAt])
  @@map("trip_costs")
}
