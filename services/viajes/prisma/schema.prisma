generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model ProcessedEvent {
  eventId     String   @id @map("event_id")
  type        String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@map("processed_events")
}

model OutboxEvent {
  eventId      String    @id @map("event_id")
  type         String
  envelope     Json
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(3)
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")
  claimedUntil DateTime? @map("claimed_until") @db.Timestamptz(3)

  @@map("outbox")
}

// Local copy fed by BranchCreated/BranchUpdated from administracion.
model BranchCopy {
  id        String   @id @db.Uuid
  code      String
  name      String
  active    Boolean
  version   Int
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("branches")
}

// Local copy fed by SettingsUpdated; J3-2 fixes the depreciation of a trip from it.
model SettingsVersionCopy {
  id                String   @id @db.Uuid
  depreciationPerKm Decimal  @map("depreciation_per_km") @db.Decimal(10, 2)
  rentalRatePerKm   Decimal  @map("rental_rate_per_km") @db.Decimal(10, 2)
  effectiveFrom     DateTime @map("effective_from") @db.Date
  createdAt         DateTime @map("created_at") @db.Timestamptz(3)

  @@index([effectiveFrom, createdAt])
  @@map("settings_versions")
}

// Copy of the buses of flota, fed by Bus* events. No foreign keys: events arrive in any order.
model BusCopy {
  id                String   @id @db.Uuid
  branchId          String   @map("branch_id") @db.Uuid
  plate             String
  capacity          Int
  operationalStatus String   @map("operational_status")
  active            Boolean
  assignedDriverId  String?  @map("assigned_driver_id") @db.Uuid
  mileageKm         Int      @default(0) @map("mileage_km")
  version           Int
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([branchId, active])
  @@map("bus_copies")
}

// Copy of the drivers of flota, fed by Driver* events.
model DriverCopy {
  id               String   @id @db.Uuid
  branchId         String   @map("branch_id") @db.Uuid
  fullName         String   @map("full_name")
  licenseExpiresOn DateTime @map("license_expires_on") @db.Date
  baseSalary       Decimal  @map("base_salary") @db.Decimal(10, 2)
  active           Boolean
  version          Int
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([branchId, active])
  @@map("driver_copies")
}

// Copy of the routes of flota, fed by Route* events. A deleted route stays as a tombstone, so a
// late RouteCreated or RouteUpdated cannot bring it back.
model RouteCopy {
  id                  String   @id @db.Uuid
  originBranchId      String?  @map("origin_branch_id") @db.Uuid
  destinationBranchId String?  @map("destination_branch_id") @db.Uuid
  distanceKm          Decimal  @map("distance_km") @db.Decimal(7, 1)
  ticketPrice         Decimal  @map("ticket_price") @db.Decimal(10, 2)
  active              Boolean
  deleted             Boolean  @default(false)
  version             Int
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([originBranchId, active])
  @@map("route_copies")
}

enum TripType {
  REGULAR
  RENTAL
}

enum TripStatus {
  SCHEDULED
  IN_TRANSIT
  COMPLETED
}

// A trip of this branch. Until it arrives, the database refuses its bus or its driver in another trip that crosses it.
model Trip {
  id                 String     @id @default(uuid()) @db.Uuid
  type               TripType
  status             TripStatus @default(SCHEDULED)
  branchId           String     @map("branch_id") @db.Uuid
  routeId            String?    @map("route_id") @db.Uuid
  busId              String     @map("bus_id") @db.Uuid
  busPlate           String     @map("bus_plate")
  capacity           Int
  driverId           String     @map("driver_id") @db.Uuid
  driverName         String     @map("driver_name")
  originLabel        String     @map("origin_label")
  destinationLabel   String     @map("destination_label")
  departureAt        DateTime   @map("departure_at") @db.Timestamptz(3)
  estimatedArrivalAt DateTime   @map("estimated_arrival_at") @db.Timestamptz(3)
  // Copied from the route when a regular trip is scheduled, so a later change of price never reaches it.
  ticketPrice        Decimal?   @map("ticket_price") @db.Decimal(10, 2)
  rentalId           String?    @map("rental_id") @db.Uuid
  createdById        String     @map("created_by_id") @db.Uuid
  searchText         String     @default("") @map("search_text")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  departure          TripDeparture?
  arrival            TripArrival?

  @@index([branchId, departureAt])
  @@index([busId])
  @@index([driverId])
  @@map("trips")
}

enum RecordedByRole {
  BRANCH_ADMIN
  DRIVER
}

// Written once when the bus leaves; a trigger refuses any UPDATE or DELETE.
model TripDeparture {
  tripId         String         @id @map("trip_id") @db.Uuid
  trip           Trip           @relation(fields: [tripId], references: [id], onDelete: Restrict)
  departedAt     DateTime       @map("departed_at") @db.Timestamptz(3)
  startMileageKm Int            @map("start_mileage_km")
  recordedById   String         @map("recorded_by_id") @db.Uuid
  recordedByRole RecordedByRole @map("recorded_by_role")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("trip_departures")
}

// Written once when the bus arrives, with the amounts fixed at that moment; a trigger refuses changes.
model TripArrival {
  tripId             String         @id @map("trip_id") @db.Uuid
  trip               Trip           @relation(fields: [tripId], references: [id], onDelete: Restrict)
  arrivedAt          DateTime       @map("arrived_at") @db.Timestamptz(3)
  endMileageKm       Int            @map("end_mileage_km")
  fuelCost           Decimal        @map("fuel_cost") @db.Decimal(10, 2)
  distanceKm         Int            @map("distance_km")
  depreciationPerKm  Decimal        @map("depreciation_per_km") @db.Decimal(10, 2)
  depreciationAmount Decimal        @map("depreciation_amount") @db.Decimal(12, 2)
  driverPay          Decimal        @map("driver_pay") @db.Decimal(10, 2)
  settingsVersionId  String         @map("settings_version_id") @db.Uuid
  recordedById       String         @map("recorded_by_id") @db.Uuid
  recordedByRole     RecordedByRole @map("recorded_by_role")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("trip_arrivals")
}

enum RentalRequestStatus {
  PENDING
  ASSIGNED
}

// A paid rental (RentalPaid) waiting for the branch admin to give it a bus and a driver.
model RentalRequest {
  id               String              @id @db.Uuid
  branchId         String              @map("branch_id") @db.Uuid
  clientName       String              @map("client_name")
  nit              String
  originLabel      String              @map("origin_label")
  destinationLabel String              @map("destination_label")
  departureAt      DateTime            @map("departure_at") @db.Timestamptz(3)
  returnAt         DateTime?           @map("return_at") @db.Timestamptz(3)
  passengers       Int
  distanceKm       Decimal             @map("distance_km") @db.Decimal(7, 1)
  price            Decimal             @db.Decimal(10, 2)
  status           RentalRequestStatus @default(PENDING)
  tripId           String?             @unique @map("trip_id") @db.Uuid
  searchText       String              @default("") @map("search_text")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([branchId, status, departureAt])
  @@map("rental_requests")
}
