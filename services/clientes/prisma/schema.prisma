generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model ProcessedEvent {
  eventId     String   @id @map("event_id")
  type        String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@map("processed_events")
}

model OutboxEvent {
  eventId      String    @id @map("event_id")
  type         String
  envelope     Json
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(3)
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")
  claimedUntil DateTime? @map("claimed_until") @db.Timestamptz(3)

  @@map("outbox")
}

// One per user, created from UserRegistered. Staff get one too, with the client fields empty.
// The NIT is unique only when present (partial index in the migration).
model ClientProfile {
  userId         String   @id @map("user_id") @db.Uuid
  email          String
  fullName       String   @map("full_name")
  role           String
  dpi            String?
  phone          String?
  nit            String?
  address        String?
  // Follow the account through UserUpdated; only a newer version is applied.
  active         Boolean  @default(true)
  accountVersion Int      @default(0) @map("account_version")
  // Filled by the trigger client_profiles_search_text.
  searchText     String   @default("") @map("search_text")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  wallet         Wallet?
  refunds        Refund[]
  rentals        Rental[]

  @@index([role, fullName, userId])
  @@map("client_profiles")
}

// The balance never goes below zero (CHECK wallets_balance_non_negative in the migration).
model Wallet {
  clientId  String           @id @map("client_id") @db.Uuid
  balance   Decimal          @default(0) @db.Decimal(12, 2)
  updatedAt DateTime         @default(now()) @map("updated_at") @db.Timestamptz(3)
  profile   ClientProfile    @relation(fields: [clientId], references: [userId], onDelete: Cascade)
  movements WalletMovement[]

  @@map("wallets")
}

enum WalletMovementKind {
  TOP_UP
  TICKET
  RENTAL
  REFUND
}

// Debits are negative. A repeated Idempotency-Key finds the movement it already created.
model WalletMovement {
  id             String             @id @db.Uuid
  clientId       String             @map("client_id") @db.Uuid
  kind           WalletMovementKind
  amount         Decimal            @db.Decimal(12, 2)
  balanceAfter   Decimal            @map("balance_after") @db.Decimal(12, 2)
  reference      String?            @db.Uuid
  description    String
  occurredOn     DateTime           @map("occurred_on") @db.Date
  idempotencyKey String             @map("idempotency_key") @db.Uuid
  fingerprint    String
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  wallet         Wallet             @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@unique([clientId, idempotencyKey])
  @@index([clientId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("wallet_movements")
}

// One per ticket the wallet was asked to refund. Without a movement, nothing had been charged and the
// row stops a debit still on its way from charging a ticket that no longer exists.
model Refund {
  reference  String        @id @db.Uuid
  clientId   String        @map("client_id") @db.Uuid
  movementId String?       @map("movement_id") @db.Uuid
  amount     Decimal       @db.Decimal(12, 2)
  reason     String
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  profile    ClientProfile @relation(fields: [clientId], references: [userId], onDelete: Cascade)

  @@map("refunds")
}

// Copy of the settings versions of administracion, fed by SettingsUpdated. Versions never change.
model SettingsVersionCopy {
  id                String   @id @db.Uuid
  depreciationPerKm Decimal  @map("depreciation_per_km") @db.Decimal(10, 2)
  rentalRatePerKm   Decimal  @map("rental_rate_per_km") @db.Decimal(10, 2)
  effectiveFrom     DateTime @map("effective_from") @db.Date
  createdAt         DateTime @map("created_at") @db.Timestamptz(3)

  @@index([effectiveFrom, createdAt])
  @@map("settings_versions")
}

enum RentalChannel {
  ONLINE
  COUNTER
}

enum RentalStatus {
  REQUESTED
  CONFIRMED
  PAID
  CANCELLED
}

// A private bus rental. Online ones belong to a client; counter ones only carry the NIT given at the
// branch (CF when none), which links them to the client who later signs up with it. The CHECK
// constraints of the migration keep the channel, the price and the payment consistent.
model Rental {
  id               String         @id @db.Uuid
  channel          RentalChannel
  status           RentalStatus
  branchId         String         @map("branch_id") @db.Uuid
  clientId         String?        @map("client_id") @db.Uuid
  nit              String
  clientName       String         @map("client_name")
  email            String?
  originLabel      String         @map("origin_label")
  destinationLabel String         @map("destination_label")
  departureAt      DateTime       @map("departure_at") @db.Timestamptz(3)
  returnAt         DateTime?      @map("return_at") @db.Timestamptz(3)
  passengers       Int
  distanceKm       Decimal        @map("distance_km") @db.Decimal(7, 1)
  ratePerKm        Decimal        @map("rate_per_km") @db.Decimal(10, 2)
  estimatedPrice   Decimal        @map("estimated_price") @db.Decimal(10, 2)
  price            Decimal?       @db.Decimal(10, 2)
  searchText       String         @map("search_text")
  requestedAt      DateTime       @default(now()) @map("requested_at") @db.Timestamptz(3)
  createdById      String         @map("created_by_id") @db.Uuid
  confirmedAt      DateTime?      @map("confirmed_at") @db.Timestamptz(3)
  confirmedById    String?        @map("confirmed_by_id") @db.Uuid
  paidOn           DateTime?      @map("paid_on") @db.Date
  paidAt           DateTime?      @map("paid_at") @db.Timestamptz(3)
  cancelledAt      DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  profile          ClientProfile? @relation(fields: [clientId], references: [userId], onDelete: Cascade)

  @@index([clientId, requestedAt(sort: Desc), id(sort: Desc)])
  @@index([nit, requestedAt(sort: Desc), id(sort: Desc)])
  @@index([branchId, status, departureAt, id])
  @@map("rentals")
}

// Copy of the branches of administracion, fed by BranchCreated/BranchUpdated: a rental is asked only
// of an active branch. Events may arrive out of order, so a row is only replaced by a higher version.
model BranchCopy {
  id        String   @id @db.Uuid
  code      String
  name      String
  active    Boolean
  version   Int
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("branches")
}
