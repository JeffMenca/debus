generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model ProcessedEvent {
  eventId     String   @id @map("event_id")
  type        String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@map("processed_events")
}

model OutboxEvent {
  eventId      String    @id @map("event_id")
  type         String
  envelope     Json
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(3)
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")
  claimedUntil DateTime? @map("claimed_until") @db.Timestamptz(3)

  @@map("outbox")
}

// One per user, created from UserRegistered. Staff get one too, with the client fields empty.
// The NIT is unique only when present (partial index in the migration).
model ClientProfile {
  userId    String   @id @map("user_id") @db.Uuid
  email     String
  fullName  String   @map("full_name")
  role      String
  dpi       String?
  phone     String?
  nit       String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  wallet    Wallet?
  refunds   Refund[]

  @@map("client_profiles")
}

// The balance never goes below zero (CHECK wallets_balance_non_negative in the migration).
model Wallet {
  clientId  String           @id @map("client_id") @db.Uuid
  balance   Decimal          @default(0) @db.Decimal(12, 2)
  updatedAt DateTime         @default(now()) @map("updated_at") @db.Timestamptz(3)
  profile   ClientProfile    @relation(fields: [clientId], references: [userId], onDelete: Cascade)
  movements WalletMovement[]

  @@map("wallets")
}

enum WalletMovementKind {
  TOP_UP
  TICKET
  RENTAL
  REFUND
}

// Debits are negative. A repeated Idempotency-Key finds the movement it already created.
model WalletMovement {
  id             String             @id @db.Uuid
  clientId       String             @map("client_id") @db.Uuid
  kind           WalletMovementKind
  amount         Decimal            @db.Decimal(12, 2)
  balanceAfter   Decimal            @map("balance_after") @db.Decimal(12, 2)
  reference      String?            @db.Uuid
  description    String
  occurredOn     DateTime           @map("occurred_on") @db.Date
  idempotencyKey String             @map("idempotency_key") @db.Uuid
  fingerprint    String
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  wallet         Wallet             @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@unique([clientId, idempotencyKey])
  @@index([clientId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("wallet_movements")
}

// One per ticket the wallet was asked to refund. Without a movement, nothing had been charged and the
// row stops a debit still on its way from charging a ticket that no longer exists.
model Refund {
  reference  String        @id @db.Uuid
  clientId   String        @map("client_id") @db.Uuid
  movementId String?       @map("movement_id") @db.Uuid
  amount     Decimal       @db.Decimal(12, 2)
  reason     String
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  profile    ClientProfile @relation(fields: [clientId], references: [userId], onDelete: Cascade)

  @@map("refunds")
}

// Copy of the settings versions of administracion, fed by SettingsUpdated. Versions never change.
model SettingsVersionCopy {
  id                String   @id @db.Uuid
  depreciationPerKm Decimal  @map("depreciation_per_km") @db.Decimal(10, 2)
  rentalRatePerKm   Decimal  @map("rental_rate_per_km") @db.Decimal(10, 2)
  effectiveFrom     DateTime @map("effective_from") @db.Date
  createdAt         DateTime @map("created_at") @db.Timestamptz(3)

  @@index([effectiveFrom, createdAt])
  @@map("settings_versions")
}
